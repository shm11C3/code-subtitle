{
  "name": "code-subtitle",
  "displayName": "Code Subtitle",
  "version": "0.1.0",
  "private": true,
  "description": "Understand selected code with short, temporary subtitles in your editor.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "code explanation",
    "code reading",
    "code review",
    "language model",
    "subtitles",
    "translation"
  ],
  "homepage": "https://github.com/shm11C3/code-subtitle#readme",
  "bugs": {
    "url": "https://github.com/shm11C3/code-subtitle/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shm11C3/code-subtitle.git"
  },
  "publisher": "Shm11C3",
  "main": "./dist/src/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "npm run build && node --test dist/test/*.test.js test/release.test.cjs",
    "test:host": "npm run build && node scripts/test-host.cjs",
    "eval:live": "npm run build && node scripts/eval-live.cjs",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/release.cjs package",
    "demo": "npm run build && node scripts/demo.cjs"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/vscode": "1.134.0",
    "@vscode/vsce": "3.9.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "7.0.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "codeSubtitle.show",
        "title": "Show Subtitle",
        "category": "Code Subtitle"
      },
      {
        "command": "codeSubtitle.dismiss",
        "title": "Dismiss Subtitle",
        "category": "Code Subtitle"
      },
      {
        "command": "codeSubtitle.clearCache",
        "title": "Clear Cache",
        "category": "Code Subtitle"
      },
      {
        "command": "codeSubtitle.chooseModel",
        "title": "Choose Model",
        "category": "Code Subtitle"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeSubtitle.show",
          "when": "editorTextFocus && !editorHasMultipleSelections",
          "group": "z_commands"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeSubtitle.show",
        "key": "shift+alt+e",
        "mac": "ctrl+alt+e",
        "when": "editorTextFocus && !editorHasMultipleSelections"
      },
      {
        "command": "codeSubtitle.dismiss",
        "key": "escape",
        "when": "editorTextFocus && codeSubtitle.active && !suggestWidgetVisible && !inlineSuggestionVisible && !findWidgetVisible && !renameInputVisible && !inSnippetMode"
      }
    ],
    "configuration": {
      "title": "Code Subtitle",
      "properties": {
        "codeSubtitle.outputLanguage": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "description": "Subtitle language tag, or auto to use the VS Code display language."
        },
        "codeSubtitle.model": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "description": "Language model ID, vendor:id, or auto to prefer Copilot and otherwise choose from available providers."
        },
        "codeSubtitle.semanticContext": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Include bounded language-service type information, documentation, and same-workspace definition excerpts in subtitle requests. Falls back to selection and nearby lines when unavailable."
        },
        "codeSubtitle.timingLog": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Write subtitle phase timings (request id, phase name, and milliseconds since the command started) to the Code Subtitle Timing output channel. Records only timings; never code, prompts, subtitles, or file names."
        }
      }
    }
  },
  "extensionKind": [
    "ui"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#101827",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.135.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "releaseChannel": "pre-release"
}
